{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shivo-labs-site",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // worker.ts uses a few lib/ files directly (outside Next), where the "server-only" marker package would throw
  "alias": { "server-only": "./scripts/server-only-stub.js" },
  // The public addresses. Wrangler creates the DNS records in the shivolabs.com zone for these.
  "routes": [
    { "pattern": "shivolabs.com", "custom_domain": true },
    { "pattern": "www.shivolabs.com", "custom_domain": true }
  ],
  // The two nightly jobs that used to be Vercel crons in vercel.json (UTC times)
  "triggers": { "crons": ["30 1 * * *", "15 3 * * *"] },
  // The visit tracker takes at most 30 reports a minute from one address (free; worker.ts)
  "ratelimits": [{ "name": "COLLECT_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "vars": {
    "SITE_URL": "https://shivolabs.com",
    "INSIGHTS_TIMEZONE": "Africa/Dar_es_Salaam",
    // Cloudflare Access guards /insights (email code); lib/auth.ts checks its signed token
    "ACCESS_TEAM_DOMAIN": "empty-cake-9a98.cloudflareaccess.com",
    "ACCESS_AUD": "98efb7a73d7a2208a68786666719a6f02b9b400c9468e6f378d43307ce2758b1",
    "INSIGHTS_EMAIL": "ishivamparmar@gmail.com"
  }
  // Secrets (never written here): DATABASE_URL, AUTH_SECRET (visitor id salt), CRON_SECRET, INSIGHTS_APP_TOKEN,
  // UMAMI_SHARE_ID. Set with: npx wrangler secret put NAME
}

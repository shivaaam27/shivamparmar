# Set these in Cloudflare → Workers & Pages → shivo-labs-site → Settings → Variables and Secrets
# (or `npx wrangler secret put NAME`). For local use put them in .env.local and .dev.vars.
# Never commit real values.

# --- Visit tracking (public; already set in code, override here if it changes)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=c8e39f81-6be1-4b1b-a492-801b885b6347
# Optional: only count visits on your real domain, not test addresses (workers.dev)
NEXT_PUBLIC_UMAMI_DOMAINS=

# --- /insights dashboard data. Free plan: turn on the website's Share URL in Umami
# (Websites → your site → Edit → Share URL) and paste the id at its end, or the whole URL.
UMAMI_SHARE_ID=
# Optional: the regional gateway, if yours isn't found automatically (e.g. https://gateway-eu.umami.is/api)
UMAMI_GATEWAY=
# Paid plans can use an API key instead (Umami → Settings → API keys)
UMAMI_API_KEY=
# Timezone the charts use
INSIGHTS_TIMEZONE=Africa/Dar_es_Salaam

# --- /insights sign-in is Cloudflare Access (ACCESS_* and INSIGHTS_EMAIL in wrangler.jsonc).
# On your own computer (next dev only), this opens /insights without signing in:
INSIGHTS_DEV_USER=
# Salt for the anonymous visitor ids: any long random string, e.g. from: openssl rand -base64 32
AUTH_SECRET=

# --- Your own copy of the visits: the Neon connection string (set as a Cloudflare secret)
DATABASE_URL=
# Optional: protects the nightly Umami backup job (any long random string)
CRON_SECRET=

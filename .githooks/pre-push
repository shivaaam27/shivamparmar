#!/bin/sh
# Stops a push that would put a key or password into git (set up once: git config core.hooksPath .githooks).
# Looks only at the lines added by the commits being pushed.
PATTERN='sk-ant-[A-Za-z0-9_-]{10,}|AIza[0-9A-Za-z_-]{30,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY|postgres(ql)?://[^ :@/]+:[^ @/]+@|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}'
zero=0000000000000000000000000000000000000000
found=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  hits=$(git log -p --no-color $range | grep -E '^\+' | grep -nE "$PATTERN")
  if [ -n "$hits" ]; then
    echo "Push stopped: this looks like a key or password:" >&2
    echo "$hits" | cut -c1-120 >&2
    found=1
  fi
done
[ $found -eq 0 ] || { echo "Remove it (keys live in .env.local or Cloudflare secrets), then push again." >&2; exit 1; }
exit 0
